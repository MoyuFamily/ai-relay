# AI Relay — Environment Variables Template
# Copy this file to .env.local (local dev) or .env (Docker Compose) and fill in your values.

# ============================================================
# 1. Authentication & Security
# ============================================================
# Client API key(s) for /v1/* endpoints (Bearer token or X-API-Key).
# Comma-separated for multiple client keys.
RELAY_API_KEY=your-secret-key-here

# Admin panel & /api/admin/* key(s) (optional — falls back to RELAY_API_KEY if unset).
# Comma-separated for multiple admin keys.
RELAY_ADMIN_KEY=your-admin-key-here

# HMAC secret for signing temporary client tokens (optional — falls back to admin/relay key).
RELAY_SIGNING_SECRET=your-signing-secret-here

# Secret for hashing Local Relay CLI device tokens (`airelay login`).
# Generate with: openssl rand -hex 32
DEVICE_TOKEN_SECRET=your-device-token-secret-here

# ============================================================
# 2. Upstream Provider API Keys (Optional — can also be managed in /admin UI)
# ============================================================
# Comma-separated for automatic multi-key rotation & cooldown failover.
OPENAI_KEYS=sk-your-openai-key-1,sk-your-openai-key-2
CLAUDE_KEYS=sk-ant-your-claude-key-1
DEEPSEEK_KEYS=sk-your-deepseek-key-1
XIAOMI_KEYS=your-xiaomi-key-1

# Optional custom upstream base URLs:
# OPENAI_BASE_URL=https://api.openai.com/v1
# CLAUDE_BASE_URL=https://api.anthropic.com
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# XIAOMI_BASE_URL=https://api.xiaomimimo.com/v1

# ============================================================
# 3. Storage Backend (Multi-Platform Auto-Detection)
# ============================================================
# - Cloudflare Pages/Workers: uses native `KV` + `DB` (D1) bindings automatically.
# - Vercel: uses Vercel KV / Upstash Redis when KV_REST_API_URL & KV_REST_API_TOKEN are set.
# - Self-Hosted (Single Node / Docker): defaults to persistent disk `./data/kv-store.json`
#   (customizable via RELAY_DATA_DIR or RELAY_STORAGE_PATH — zero external DB required).
# - Self-Hosted (Multi-Node / Cluster): set DATABASE_URL to PostgreSQL; all tables are
#   created automatically on startup.

# Vercel KV / Upstash Redis:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Self-Hosted Persistent Disk Mode (single instance):
# RELAY_DATA_DIR=./data
# RELAY_STORAGE_PATH=./data/kv-store.json

# Self-Hosted PostgreSQL Mode (multi-instance / VPS / Docker):
# DATABASE_URL=postgresql://airelay:airelay@localhost:5432/airelay
# DATABASE_POOL_MAX=10

# ============================================================
# 4. Cron & Background Jobs
# ============================================================
# Secret header (`x-cron-secret`) for external cron triggers (/api/cron/*):
# CRON_SECRET=your-cron-secret

# Self-Hosted built-in background scheduler (runs automatically on Node.js servers;
# disabled automatically on Vercel and Cloudflare):
# ENABLE_SELF_HOSTED_CRON=true
# SELF_HOSTED_PROBE_INTERVAL_MINUTES=60

# ============================================================
# 5. Quotas, Traffic Guards & Upstream Tuning (Optional)
# ============================================================
# Global request quotas (0 = unlimited; can also be overridden in /admin UI):
# RELAY_DAILY_LIMIT=0
# RELAY_MONTHLY_LIMIT=0

# Per-instance concurrent /v1/* request cap (0 = unlimited):
# RELAY_MAX_CONCURRENT=0

# Allowed CORS origins for browser clients (comma-separated or *):
# RELAY_ALLOWED_ORIGINS=*

# Upstream request timeout in milliseconds (default 50000ms):
# RELAY_UPSTREAM_TIMEOUT_MS=50000

# Override default User-Agent sent to upstream providers:
# RELAY_DEFAULT_USER_AGENT=Mozilla/5.0 (compatible; AIRelay/1.0)

# Minimum character length for provider API keys added via /admin (0 to disable):
# RELAY_API_KEY_MIN_LENGTH=20
