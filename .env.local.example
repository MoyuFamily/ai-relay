# AI Relay — Environment Variables Template
# Copy this file to .env.local (local dev) or .env (Docker Compose) and fill in your values.

# ============================================================
# 1. Authentication & Security
# ============================================================
# Client API key(s) for /v1/* endpoints (Bearer token or X-API-Key).
# Comma-separated for multiple client keys.
RELAY_API_KEY=your-secret-key-here

# Admin panel & /api/admin/* key(s) (optional — falls back to RELAY_API_KEY if unset).
# Comma-separated for multiple admin keys.
RELAY_ADMIN_KEY=your-admin-key-here

# HMAC secret for signing temporary client tokens (optional — falls back to admin/relay key).
RELAY_SIGNING_SECRET=your-signing-secret-here

# Secret for hashing Local Relay CLI device tokens (`airelay login`).
# Generate with: openssl rand -hex 32
DEVICE_TOKEN_SECRET=your-device-token-secret-here

# ============================================================
# 2. Upstream Provider API Keys (Optional — can also be managed in /admin UI)
# ============================================================
# Comma-separated for automatic multi-key rotation & cooldown failover.
OPENAI_KEYS=sk-your-openai-key-1,sk-your-openai-key-2
CLAUDE_KEYS=sk-ant-your-claude-key-1
GEMINI_KEYS=AIza-your-gemini-key-1
DEEPSEEK_KEYS=sk-your-deepseek-key-1
OPENROUTER_KEYS=sk-or-v1-your-openrouter-key-1
# XIAOMI_KEYS=your-xiaomi-key-1

# Optional custom upstream base URLs:
# OPENAI_BASE_URL=https://api.openai.com/v1
# CLAUDE_BASE_URL=https://api.anthropic.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# XIAOMI_BASE_URL=https://api.xiaomimimo.com/v1

# ============================================================
# 3. Storage Backend (Multi-Platform Auto-Detection)
# ============================================================
# - Cloudflare Pages/Workers: uses native `KV` + `DB` (D1) bindings automatically.
# - Vercel: uses Vercel KV / Upstash Redis when KV_REST_API_URL & KV_REST_API_TOKEN are set.
# - Self-Hosted (Single Node / Docker): defaults to persistent disk `./data/kv-store.json`
#   (customizable via RELAY_DATA_DIR or RELAY_STORAGE_PATH — zero external DB required).
# - Self-Hosted (Multi-Node / Cluster): set DATABASE_URL to PostgreSQL; all tables are
#   created automatically on startup.

# Vercel KV / Upstash Redis (both Upstash Marketplace defaults and legacy Vercel KV vars are supported):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Self-Hosted Persistent Disk Mode (single instance):
# RELAY_DATA_DIR=./data
# RELAY_STORAGE_PATH=./data/kv-store.json
# Optional explicit backend override (`file` | `postgres`):
# RELAY_STORAGE_BACKEND=

# Self-Hosted PostgreSQL Mode (multi-instance / VPS / Docker; takes precedence over default RELAY_DATA_DIR):
# DATABASE_URL=postgresql://airelay:airelay@localhost:5432/airelay
# DATABASE_POOL_MAX=10

# ============================================================
# 4. Cron & Self-Hosted Scheduler (Minimal Boot Settings)
# ============================================================
# Public URL of your deployed instance (used by GitHub Actions cron.yml & reverse-proxy device login;
# can also be managed live in /admin -> Tools -> Runtime Settings):
# DEPLOY_URL=https://your-relay.example.com

# Secret header (`Authorization: Bearer <CRON_SECRET>` or `x-cron-secret`) for cron triggers (/api/cron/*);
# can also be managed live in /admin -> Tools -> Runtime Settings:
# CRON_SECRET=your-cron-secret

# Self-Hosted built-in background scheduler (runs automatically on Node.js servers;
# disabled automatically on Vercel and Cloudflare):
# ENABLE_SELF_HOSTED_CRON=true

# Allowed CORS origins for browser clients (comma-separated or *; alias: CORS_ORIGINS):
# RELAY_ALLOWED_ORIGINS=*

# ============================================================
# 5. Optional Env Fallbacks (Recommended: Configure Live in /admin -> Tools -> Runtime Settings)
# ============================================================
# Precedence: Admin Runtime Settings (/api/admin/settings) > Env Var > Platform Default.
# You normally do NOT need to set any of the variables below in Vercel / Cloudflare / Docker.
#
# Platform defaults:
# - Upstream timeout: 90000ms (Cloudflare), 240000ms (Vercel Fluid Compute 300s), 300000ms (Self-Hosted)
# - Concurrency / Queue: 5 / 10 (Cloudflare), 20 / 50 (Vercel / Self-Hosted)
# - Max request body: 4.5MB (Vercel), 10MB (Cloudflare / Self-Hosted)
# - Request log persistence: false (D1 on Cloudflare, KV/Redis on Vercel, File/Postgres on Self-Hosted)
#
# RELAY_DAILY_LIMIT=0
# RELAY_MONTHLY_LIMIT=0
# RELAY_UPSTREAM_TIMEOUT_MS=240000
# RELAY_FALLBACK_ON_TIMEOUT=false
# RELAY_MAX_CONCURRENT=20
# RELAY_MAX_QUEUE=50
# RELAY_MAX_REQUEST_BYTES=4718592
# ENABLE_REQUEST_LOGS=false
# REQUEST_LOGS_MAX_ENTRIES=100
# ALLOW_LOCAL_KEY_SYNC=true
# RELAY_DEFAULT_USER_AGENT=Mozilla/5.0 (compatible; AIRelay/1.0)
# SELF_HOSTED_PROBE_INTERVAL_MINUTES=60
# RELAY_API_KEY_MIN_LENGTH=20
# RELAY_KV_USAGE_SAMPLE_RATE=1
# RELAY_KV_KEY_USAGE_MODE=off
# RELAY_KV_KEY_USAGE_SAMPLE_RATE=0.1
# RELAY_KV_ERROR_DETAIL_SAMPLE_RATE=0.2
# RELAY_STREAM_BYTES_PER_TOKEN=4
# RELAY_KEY_POOL_VERSION_TTL_MS=30000
